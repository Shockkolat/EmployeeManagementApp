<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmployeeManagementApp.ViewModels"
             x:Class="EmployeeManagementApp.SummaryPage"
             Title="สรุป"
             Shell.BackgroundColor="#FF5722"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White">

    <ContentPage.BindingContext>
        <vm:SummaryViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, Auto, *" BackgroundColor="#F5F5F5">

        <!-- Top Header & Menu -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="16,12" BackgroundColor="White">
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label Text="เลือกปี" TextColor="#616161" VerticalOptions="Center"/>
                <Border BackgroundColor="#E0E0E0" StrokeShape="RoundRectangle 6" Padding="10,4">
                    <Label Text="{Binding SelectedYear}" FontAttributes="Bold" TextColor="#212121"/>
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="16">
                <VerticalStackLayout Spacing="2">
                    <Border BackgroundColor="#2E7D32" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                        <Label Text="+" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="เบิก" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Border BackgroundColor="#FFF9C4" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Stroke="#FBC02D">
                        <Label Text="📋" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="รายการ" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Border BackgroundColor="#E0F7FA" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Stroke="#00ACC1">
                        <Label Text="📊" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="สรุป" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <!-- Tab Switcher Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="16,12" BackgroundColor="#E3F2FD">
            <Border StrokeShape="RoundRectangle 10">
            </Border>
            <Button Grid.Column="0" Text="⊞ ตามหมวดหมู่" 
            Command="{Binding SelectTabCommand}" CommandParameter="Category"
            BackgroundColor="{Binding IsCategoryTabSelected, Converter={StaticResource BoolToColorConverter}, FallbackValue='#1E88E5'}"
            TextColor="White" CornerRadius="8" HeightRequest="38" FontAttributes="Bold" FontSize="13"/>

            <Button Grid.Column="1" Text="≡ รายสวัสดิการ" 
            Command="{Binding SelectTabCommand}" CommandParameter="Benefit"
            BackgroundColor="{Binding IsBenefitTabSelected, Converter={StaticResource BoolToColorConverter}, FallbackValue='#1E88E5'}"
            TextColor="White" CornerRadius="8" HeightRequest="38" FontAttributes="Bold" FontSize="13"/>
        </Grid>

        <!-- Dynamic Content Section -->
        <Grid Grid.Row="2">

            <!-- TAB 1: ตามหมวดหมู่ -->
            <ScrollView Padding="16,4,16,16">
                <ScrollView.Triggers>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsCategoryTabSelected}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsCategoryTabSelected}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </ScrollView.Triggers>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <!-- การ์ดหมวดหมู่หลัก -->
                            <Border StrokeShape="RoundRectangle 20" 
                        BackgroundColor="{Binding CardBgColor}" 
                        Padding="16" 
                        StrokeThickness="0">

                                <VerticalStackLayout Spacing="12">

                                    <!-- Header การ์ดหลัก -->
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                        <!-- ไอคอนวงกลมหัวข้อ -->
                                        <Border Grid.Column="0" 
                                    BackgroundColor="{Binding HeaderIconBgColor}" 
                                    StrokeShape="RoundRectangle 20" 
                                    WidthRequest="40" 
                                    HeightRequest="40" 
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                            <Label Text="{Binding Icon}" 
                                       FontSize="18" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding CategoryTitle}" 
                                       FontAttributes="Bold" 
                                       FontSize="15" 
                                       TextColor="#333333"/>
                                            <Label Text="{Binding SubTitleText}" 
                                       FontSize="11" 
                                       TextColor="#999999"/>

                                            <HorizontalStackLayout Spacing="6" Margin="0,2,0,4">
                                                <Label Text="{Binding MainValueText}" 
                                           FontSize="24" 
                                           FontAttributes="Bold" 
                                           TextColor="{Binding AccentColor}"/>
                                                <Label Text="{Binding UnitText}" 
                                           FontSize="14" 
                                           TextColor="#666666" 
                                           VerticalOptions="End" 
                                           Margin="0,0,0,3"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- รายการย่อยสีขาว (SubItems) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubItems}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeShape="RoundRectangle 16" 
                                            BackgroundColor="White" 
                                            Padding="12,10" 
                                            StrokeThickness="0">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                                        <!-- ไอคอนย่อย -->
                                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center"/>

                                                        <!-- ชื่อรายการย่อย & Progress Bar -->
                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                                            <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="#444444"/>
                                                            <ProgressBar Progress="{Binding Progress}" 
                                                             ProgressColor="{Binding BindingContext.AccentColor, Source={RelativeSource AncestorType={x:Type VerticalStackLayout}}}" 
                                                             BackgroundColor="#E0E0E0" 
                                                             HeightRequest="4"/>
                                                        </VerticalStackLayout>

                                                        <!-- Badge จำนวนเงิน/รายการ -->
                                                        <Border Grid.Column="2" 
                                                    BackgroundColor="{Binding BindingContext.BadgeBgColor, Source={RelativeSource AncestorType={x:Type VerticalStackLayout}}}" 
                                                    StrokeShape="RoundRectangle 12" 
                                                    Padding="10,4" 
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center">
                                                            <Label Text="{Binding ValueText}" 
                                                       FontSize="11" 
                                                       FontAttributes="Bold" 
                                                       TextColor="{Binding BindingContext.AccentColor, Source={RelativeSource AncestorType={x:Type VerticalStackLayout}}}"/>
                                                        </Border>

                                                        <!-- ลูกศร > -->
                                                        <Label Grid.Column="3" Text=">" TextColor="#93C5FD" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <!-- TAB 2: รายสวัสดิการ -->
            <ScrollView Padding="16,0,16,16">
                <ScrollView.Triggers>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsBenefitTabSelected}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsBenefitTabSelected}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </ScrollView.Triggers>

                <VerticalStackLayout Spacing="12">

                    <!-- Header Filter Dropdown -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="4,0,4,4">
                        <Label Grid.Column="0" 
                   Text="แสดงสวัสดิการ" 
                   FontSize="13" 
                   TextColor="#444444" 
                   VerticalOptions="Center"/>

                        <Border Grid.Column="1" 
                    HorizontalOptions="Start" 
                    Margin="12,0,0,0"
                    BackgroundColor="#EBF3FE" 
                    StrokeShape="RoundRectangle 10" 
                    StrokeThickness="0" 
                    Padding="12,2">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Picker ItemsSource="{Binding FilterOptions}" 
                            SelectedItem="{Binding SelectedFilter}"
                            FontSize="12" 
                            TextColor="#2563EB" 
                            TitleColor="#2563EB"
                            HeightRequest="36"
                            VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- List รายการสวัสดิการ -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 18" 
                            BackgroundColor="White" 
                            Stroke="#E5E7EB" 
                            StrokeThickness="1" 
                            Padding="12,10">

                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                        <!-- ไอคอนด้านซ้าย -->
                                        <Label Grid.Column="0" 
                                   Text="{Binding Icon}" 
                                   FontSize="22" 
                                   VerticalOptions="Center"/>

                                        <!-- ชื่อสวัสดิการ & Progress Bar (ถ้ามี) -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding Title}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="#333333"/>

                                            <ProgressBar Progress="{Binding Progress}" 
                                             IsVisible="{Binding HasProgress}" 
                                             ProgressColor="#2563EB" 
                                             BackgroundColor="#E0F2FE" 
                                             HeightRequest="5"/>
                                        </VerticalStackLayout>

                                        <!-- Badge แสดงราคา และ จำนวนรายการ -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                            <Border BackgroundColor="#E0F2FE" 
                                        StrokeShape="RoundRectangle 10" 
                                        Padding="10,3" 
                                        StrokeThickness="0"
                                        HorizontalOptions="End">
                                                <Label Text="{Binding AmountText}" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="#2563EB"/>
                                            </Border>

                                            <Label Text="{Binding CountText}" 
                                       FontSize="10" 
                                       TextColor="#9CA3AF" 
                                       HorizontalOptions="End"/>
                                        </VerticalStackLayout>

                                        <!-- ลูกศร > -->
                                        <Label Grid.Column="3" 
                                   Text=">" 
                                   TextColor="#60A5FA" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>

</ContentPage>