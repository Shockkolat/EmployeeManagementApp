<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeManagementApp.SummaryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F6F8">

    <Grid RowDefinitions="Auto, *">

        <!-- ================= 1. CUSTOM HEADER BAR ================= -->
        <Grid Grid.Row="0" BackgroundColor="#FF5722" HeightRequest="56" Padding="12,0" ColumnDefinitions="Auto, *, Auto">

            <!-- ปุ่มกดย้อนกลับ (<) -->
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="‹" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-4,0,0"/>
            </Border>

            <!-- หัวข้อหน้า -->
            <Label Grid.Column="1" Text="สรุป" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- ================= 2. MAIN CONTENT AREA ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,12">

                <!-- Header Action Bar (เลือกปี + เมนูขวา) -->
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Dropdown List เลือกปี -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label Text="เลือกปี" TextColor="#616161" FontSize="14" VerticalOptions="Center"/>
                        <Border BackgroundColor="#E8EAF6" StrokeShape="RoundRectangle 8" Padding="8,0" StrokeThickness="0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="YearPicker"
                                        Grid.Column="0"
                                        TextColor="#1A237E"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Title="2569"
                                        TitleColor="#1A237E"
                                        SelectedIndexChanged="OnYearPickerChanged" />
                                <Label Grid.Column="1" Text="˅" TextColor="#1A237E" FontSize="10" VerticalOptions="Center" InputTransparent="True"/>
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- เมนูขวา (เบิก, รายการ, สรุป) -->
                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreateWithdrawalTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border BackgroundColor="#2E7D32" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                                <Label Text="+" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="เบิก" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWithdrawalListTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border BackgroundColor="#FFF9C4" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Stroke="#FBC02D">
                                <Label Text="📋" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="รายการ" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Border BackgroundColor="#E0F7FA" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Stroke="#00ACC1">
                                <Label Text="📊" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="สรุป" FontSize="11" TextColor="#616161" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Tab Switcher -->
                <Border x:Name="TabSwitcherBorder" BackgroundColor="#E8EEF9" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="4">
                    <Grid ColumnDefinitions="*, *">
                        <Border x:Name="TabCategoryBorder" Grid.Column="0" BackgroundColor="#2979FF" StrokeShape="RoundRectangle 16" Padding="0,10" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTabTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="🧱" FontSize="14" VerticalOptions="Center"/>
                                <Label x:Name="TabCategoryLabel" Text="ตามหมวดหมู่" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="TabWelfareBorder" Grid.Column="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 16" Padding="0,10" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWelfareTabTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="📑" FontSize="14" VerticalOptions="Center"/>
                                <Label x:Name="TabWelfareLabel" Text="รายสวัสดิการ" TextColor="#5C6BC0" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= VIEW 1: ตามหมวดหมู่ ================= -->
                <VerticalStackLayout x:Name="ViewCategory" Spacing="16" IsVisible="True">
                    <Border BackgroundColor="#F0F5FF" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#2979FF" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                                    <Label Text="💼" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="งานและการปฏิบัติงาน" TextColor="#1A237E" FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="ใช้ไปแล้วทั้งหมด" TextColor="#7E57C2" FontSize="11"/>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="5,900" TextColor="#2979FF" FontAttributes="Bold" FontSize="26"/>
                                <Label Text="บาท" TextColor="#2979FF" FontSize="14" VerticalOptions="End" Margin="0,0,0,4"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout x:Name="WorkCategoryList" Spacing="8"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#FFF8F0" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#FF6D00" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                                    <Label Text="🎁" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="ทรัพยากรและสวัสดิการในการทำงาน" TextColor="#3E2723" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="ขอไปแล้วทั้งหมด" TextColor="#8D6E63" FontSize="11"/>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="12" TextColor="#FF6D00" FontAttributes="Bold" FontSize="26"/>
                                <Label Text="รายการ" TextColor="#FF6D00" FontSize="14" VerticalOptions="End" Margin="0,0,0,4"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout x:Name="ResourceCategoryList" Spacing="8"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ================= VIEW 2: รายสวัสดิการ ================= -->
                <VerticalStackLayout x:Name="ViewWelfare" Spacing="12" IsVisible="False">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="แสดงสวัสดิการ" TextColor="#616161" FontSize="13" VerticalOptions="Center"/>

                        <Border BackgroundColor="#E8EAF6" StrokeShape="RoundRectangle 12" Padding="8,0" StrokeThickness="0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="WelfareFilterPicker"
                                        Grid.Column="0"
                                        TextColor="#1A237E"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Title="ทั้งหมด"
                                        TitleColor="#1A237E"
                                        SelectedIndexChanged="OnWelfareFilterChanged" />
                                <Label Grid.Column="1" Text="˅" TextColor="#1A237E" FontSize="10" VerticalOptions="Center" InputTransparent="True"/>
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>

                    <VerticalStackLayout x:Name="WelfareItemList" Spacing="8" IsVisible="True"/>
                    <VerticalStackLayout x:Name="WelfareGroupCategoryList" Spacing="12" IsVisible="False"/>
                </VerticalStackLayout>

                <!-- ================= VIEW 3: Drill-down 1 ================= -->
                <VerticalStackLayout x:Name="ViewSubCategoryDetail" Spacing="12" IsVisible="False">
                    <VerticalStackLayout Spacing="4" Margin="0,4">
                        <Label x:Name="SubGroupTitleLabel" Text="งานและการปฏิบัติงาน" TextColor="#757575" FontSize="12"/>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label x:Name="SubCategoryIconLabel" Text="🧳" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="SubCategoryTitleLabel" Text="ปฏิบัติงานนอกสถานที่" TextColor="#1976D2" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SubCategoryDetailList" Spacing="8"/>
                </VerticalStackLayout>

                <!-- ================= VIEW 4: Drill-down 2 ================= -->
                <VerticalStackLayout x:Name="ViewWelfareDetail" Spacing="12" IsVisible="False">
                    <Label Text="สวัสดิการทั้งหมด" TextColor="#757575" FontSize="12"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="0,0,0,4">
                        <Border Grid.Column="0" BackgroundColor="#F5F6F8" StrokeShape="RoundRectangle 12" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                            <Label x:Name="WelfareDetailIconLabel" Text="🚌" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Label Grid.Column="1" x:Name="WelfareDetailTitleLabel" Text="พาหนะ,ขนส่ง" TextColor="#1976D2" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                            <Border BackgroundColor="#E3F2FD" StrokeShape="RoundRectangle 12" Padding="10,4" StrokeThickness="0">
                                <Label x:Name="WelfareDetailTotalAmountLabel" Text="5,750 บาท" TextColor="#2979FF" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                            <Label x:Name="WelfareDetailTotalCountLabel" Text="3 รายการ" TextColor="#9E9E9E" FontSize="11" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout x:Name="WelfareDetailTransactionList" Spacing="10"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>